# Optional path overrides. Defaults point to folders inside this repository.
MDPLUS_POLICY_LIBRARY_ROOT=/absolute/path/to/policy_library
MDPLUS_POLICY_PLATFORM_ROOT=/absolute/path/to/policy_platform
MDPLUS_EPISODES_ROOT=/absolute/path/to/private_episode_storage
MDPLUS_CONTROLLER_KEYS_ROOT=/absolute/path/to/private_controller_keys

# The launcher uses the locally authenticated Codex CLI. Do not place API keys
# or patient information in this file.
